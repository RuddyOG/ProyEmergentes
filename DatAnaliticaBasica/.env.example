# ============================================================
# CONFIGURACIÓN DE RUTAS DE DATOS
# ============================================================

# Directorio donde están los archivos JSONL
DATA_PATH=./data

# Nombres de los archivos JSONL (por defecto)
AIR_FILE=air.jsonl
SOUND_FILE=sound.jsonl
LIQUID_FILE=liquid.jsonl

# ============================================================
# CONFIGURACIÓN DE PRODUCCIÓN
# Descomenta y configura para usar rutas de red o cloud
# ============================================================

# Para rutas de red
# DATA_PATH=/mnt/network/sensor_data
# DATA_PATH=\\server\shared\sensor_data

# Para rutas específicas por archivo
# AIR_FILE=/path/to/air_quality_data.jsonl
# SOUND_FILE=/path/to/sound_levels.jsonl
# LIQUID_FILE=/path/to/liquid_sensors.jsonl

# ============================================================
# CONFIGURACIÓN DE API (para FastAPI)
# ============================================================

API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# ============================================================
# EJEMPLOS DE CONFIGURACIÓN
# ============================================================

# Desarrollo Local:
# DATA_PATH=.
# AIR_FILE=air.jsonl
# SOUND_FILE=sound.jsonl
# LIQUID_FILE=liquid.jsonl

# Servidor de Producción:
# DATA_PATH=/var/data/sensors
# AIR_FILE=air_quality.jsonl
# SOUND_FILE=noise_levels.jsonl
# LIQUID_FILE=tank_levels.jsonl

# AWS S3 (con s3fs):
# DATA_PATH=/mnt/s3bucket/sensor-data
# AIR_FILE=latest/air.jsonl
# SOUND_FILE=latest/sound.jsonl
# LIQUID_FILE=latest/liquid.jsonl