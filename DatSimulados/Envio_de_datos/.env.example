# Configuración del Endpoint
# URL del endpoint donde se enviarán los datos
ENDPOINT_URL=http://localhost:8000/api/sensor-data

# Configuración de Envío
# Tiempo de espera entre el envío de cada fila (en segundos)
DELAY_BETWEEN_ROWS=1.0

# Número de reintentos en caso de fallo
RETRY_ATTEMPTS=3

# Timeout para cada petición (en segundos)
TIMEOUT=10

# Directorio donde se encuentran los archivos CSV
# '.' significa el directorio actual
CSV_DIRECTORY=.

# Ejemplos de configuración:
# Para producción:
# ENDPOINT_URL=https://api.tudominio.com/sensor-data
# DELAY_BETWEEN_ROWS=0.5
# RETRY_ATTEMPTS=5
# CSV_DIRECTORY=/ruta/a/tus/csvs

# Para desarrollo local:
# ENDPOINT_URL=http://localhost:3000/data
# DELAY_BETWEEN_ROWS=2.0